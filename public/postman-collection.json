              ]
            },
            "description": "Parcial."
          }
        },
        {
          "name": "Excluir produto",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{id}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{id}"
              ]
            },
            "description": "Exclui o produto e todo o conteúdo (módulos, aulas). Idempotente."
          }
        }
      ]
    },
